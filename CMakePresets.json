{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wno-mismatched-new-delete",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "LFIF_BUILD_EXTRAS": false
      }
    },
    {
      "name": "optimized",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wno-mismatched-new-delete -march=native",
        "BUILD_TESTING": true,
        "LFIF_BUILD_EXTRAS": false
      }
    },
    {
      "name": "full-check",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wno-mismatched-new-delete",
        "BUILD_TESTING": true,
        "LFIF_BUILD_EXTRAS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "configurePreset": "development"
    },
    {
      "name": "optimized",
      "configurePreset": "optimized"
    },
    {
      "name": "full-check",
      "configurePreset": "full-check"
    }
  ],
  "testPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "optimized",
      "configurePreset": "optimized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "full-check",
      "configurePreset": "full-check",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
